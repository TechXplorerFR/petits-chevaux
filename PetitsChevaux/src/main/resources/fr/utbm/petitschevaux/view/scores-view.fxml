<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<!-- Classement des joueurs, puis un onglet par mode de jeu (rempli par ScoresController) :
     moyennes depuis la première partie, dernière partie détaillée et dernières parties. -->
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="fr.utbm.petitschevaux.controller.ScoresController"
      alignment="TOP_CENTER" spacing="16.0" style="-fx-background-color: #f4f0e7;">
    <padding>
        <Insets bottom="24.0" left="40.0" right="40.0" top="24.0"/>
    </padding>

    <Label text="Scores">
        <font>
            <Font name="System Bold" size="32.0"/>
        </font>
    </Label>
    <Label fx:id="message" wrapText="true" style="-fx-text-fill: #6b665e;"/>

    <VBox spacing="8.0" alignment="TOP_CENTER">
        <Label text="Meilleurs joueurs" style="-fx-font-weight: bold; -fx-font-size: 15px;"/>
        <GridPane fx:id="classement" maxWidth="-Infinity"
                  style="-fx-background-color: white; -fx-background-radius: 8;"/>
    </VBox>

    <!-- minHeight = taille préférée : l'onglet n'est jamais écrasé, c'est la page qui défile -->
    <TabPane fx:id="ongletsModes" tabClosingPolicy="UNAVAILABLE" minHeight="-Infinity"/>

    <Button text="Menu principal" onAction="#onRetourMenu" prefWidth="180.0" defaultButton="true"/>
</VBox>
