<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:id="racine"
      fx:controller="fr.utbm.petitschevaux.controller.MenuController"
      alignment="CENTER" spacing="16.0" style="-fx-background-color: #f4f0e7;">
    <padding>
        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0"/>
    </padding>

    <!-- Taille du titre adaptée à la largeur de la fenêtre par MenuController -->
    <Label fx:id="titre" text="Petits chevaux" styleClass="titre-menu" graphicTextGap="14.0"/>

    <HBox alignment="CENTER" spacing="10.0">
        <Label text="Joueurs humains :"/>
        <Spinner fx:id="nombreJoueurs" prefWidth="80.0"/>
    </HBox>

    <Label text="Les couleurs restantes sont jouées par des bots." wrapText="true"
           style="-fx-text-fill: #6b665e;"/>

    <VBox fx:id="champsJoueurs" alignment="CENTER" spacing="8.0" maxWidth="280.0"/>

    <Separator maxWidth="280.0"/>

    <FlowPane alignment="CENTER" hgap="16.0" vgap="8.0">
        <Label text="Mode de jeu :"/>
        <RadioButton fx:id="modeClassique" text="Classique" selected="true"/>
        <RadioButton fx:id="modeCasesSpeciales" text="Cases spéciales"/>
    </FlowPane>
    <Label fx:id="descriptionMode" wrapText="true" maxWidth="440.0" textAlignment="CENTER" alignment="CENTER"
           style="-fx-text-fill: #6b665e;"/>

    <Separator maxWidth="280.0"/>

    <!-- Deux colonnes de boutons, une seule quand la fenêtre est trop étroite -->
    <FlowPane alignment="CENTER" hgap="12.0" vgap="10.0" maxWidth="490.0">
        <Button text="Nouvelle partie" onAction="#onNouvellePartie" prefWidth="230.0" defaultButton="true"/>
        <Button text="Charger une partie" onAction="#onChargerPartie" prefWidth="230.0"/>
        <Button text="Héberger une partie en ligne" onAction="#onHeberger" prefWidth="230.0"/>
        <Button text="Rejoindre une partie en ligne" onAction="#onRejoindre" prefWidth="230.0"/>
        <Button text="Scores" onAction="#onScores" prefWidth="230.0"/>
        <Button text="Quitter" onAction="#onQuitter" prefWidth="230.0"/>
    </FlowPane>
    <Label text="En ligne, le premier joueur ci-dessus est vous : son nom et sa couleur sont utilisés."
           wrapText="true" textAlignment="CENTER" style="-fx-text-fill: #6b665e;"/>
</VBox>
