<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Mise en page adaptée à la taille de la fenêtre par PartieController :
     le plateau est mis à l'échelle et, en fenêtre étroite, le panneau de gauche
     passe sous les commandes de droite. -->
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:id="racine"
            fx:controller="fr.utbm.petitschevaux.controller.PartieController"
            style="-fx-background-color: #f4f0e7;">

    <left>
        <!-- Onglets affichés seulement s'ils servent : cases spéciales et/ou chat en ligne -->
        <TabPane fx:id="panneauGauche" prefWidth="260.0" maxWidth="260.0" tabClosingPolicy="UNAVAILABLE">
            <Tab fx:id="ongletCases" text="Cases spéciales">
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="colonne-defilante">
                    <VBox fx:id="panneauSpecial" spacing="10.0">
                        <padding>
                            <Insets bottom="12.0" left="12.0" right="8.0" top="12.0"/>
                        </padding>
                        <VBox fx:id="legende" spacing="6.0"/>
                        <Label text="Derniers effets" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                        <VBox fx:id="journal" spacing="6.0" VBox.vgrow="ALWAYS"
                              style="-fx-border-color: #c6c0b5; -fx-border-radius: 4; -fx-padding: 8;"/>
                    </VBox>
                </ScrollPane>
            </Tab>
            <Tab fx:id="ongletChat" text="Chat">
                <StackPane fx:id="zoneChat">
                    <padding>
                        <Insets bottom="12.0" left="12.0" right="8.0" top="12.0"/>
                    </padding>
                </StackPane>
            </Tab>
        </TabPane>
    </left>

    <center>
        <!-- Le plateau y est centré et mis à l'échelle pour occuper la place disponible -->
        <StackPane fx:id="zonePlateau" minWidth="0.0" minHeight="0.0" prefWidth="600.0" prefHeight="600.0"/>
    </center>

    <right>
        <ScrollPane fx:id="defilementDroite" fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER"
                    styleClass="colonne-defilante">
            <VBox fx:id="colonneDroite" alignment="CENTER" spacing="16.0" prefWidth="230.0">
                <padding>
                    <Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/>
                </padding>
                <Label fx:id="resultatDe" text="Résultat du dé : " wrapText="true" minHeight="-Infinity"/>
                <StackPane fx:id="vueDe" prefHeight="70.0" prefWidth="70.0"/>
                <Label fx:id="information" text="Joueur 1 - lancez le dé" wrapText="true" minHeight="-Infinity"
                       textAlignment="CENTER"/>
                <Button fx:id="boutonLancer" text="Lancer le dé" onAction="#onLancerDe" defaultButton="true"/>
                <!-- Vitesse des coups : Rapide et Éclair suppriment l'animation du dé -->
                <VBox alignment="CENTER" spacing="4.0">
                    <Label text="Vitesse des coups" style="-fx-font-weight: bold;"/>
                    <HBox alignment="CENTER" spacing="4.0">
                        <fx:define>
                            <ToggleGroup fx:id="groupeVitesse"/>
                        </fx:define>
                        <ToggleButton fx:id="vitesseNormale" text="Normale" toggleGroup="$groupeVitesse"
                                      selected="true" onAction="#onChangerVitesse"/>
                        <ToggleButton fx:id="vitesseRapide" text="Rapide" toggleGroup="$groupeVitesse"
                                      onAction="#onChangerVitesse"/>
                        <ToggleButton fx:id="vitesseEclair" text="Éclair" toggleGroup="$groupeVitesse"
                                      onAction="#onChangerVitesse"/>
                    </HBox>
                </VBox>
                <VBox fx:id="joueursAffiches" spacing="4.0"/>
                <VBox fx:id="historiqueLancers" prefHeight="170.0" minHeight="170.0"
                      maxHeight="170.0" spacing="2.0"
                      style="-fx-border-color: #c6c0b5; -fx-border-radius: 4; -fx-padding: 8;"/>
                <Button fx:id="boutonSauvegarder" text="Sauvegarder" onAction="#onSauvegarder"/>
                <Button text="Menu principal" onAction="#onRetourMenu"/>
            </VBox>
        </ScrollPane>
    </right>
</BorderPane>
