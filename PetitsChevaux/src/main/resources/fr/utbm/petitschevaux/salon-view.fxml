<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="fr.utbm.petitschevaux.SalonController"
      alignment="TOP_CENTER" spacing="16.0" style="-fx-background-color: #f4f0e7;">
    <padding>
        <Insets bottom="24.0" left="40.0" right="40.0" top="24.0"/>
    </padding>

    <Label text="Salon de la partie en ligne">
        <font>
            <Font name="System Bold" size="30.0"/>
        </font>
    </Label>
    <Label fx:id="adresse" wrapText="true" textAlignment="CENTER" style="-fx-font-size: 14px;"/>
    <Label fx:id="regles" style="-fx-text-fill: #6b665e;"/>

    <HBox spacing="24.0" VBox.vgrow="ALWAYS">
        <VBox spacing="8.0" prefWidth="320.0" minWidth="320.0">
            <Label text="Joueurs" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
            <VBox fx:id="places" spacing="8.0"
                  style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 12;"/>
            <Label text="Les places libres seront prises par des bots."
                   wrapText="true" style="-fx-text-fill: #6b665e;"/>
        </VBox>
        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
            <Label text="Chat" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
            <StackPane fx:id="zoneChat" VBox.vgrow="ALWAYS"/>
        </VBox>
    </HBox>

    <Label fx:id="message" wrapText="true" style="-fx-font-size: 14px;"/>

    <HBox alignment="CENTER" spacing="16.0">
        <Button text="Quitter le salon" onAction="#onQuitter" prefWidth="180.0"/>
        <Button fx:id="boutonLancer" text="Lancer la partie" onAction="#onLancer"
                prefWidth="200.0" defaultButton="true"/>
    </HBox>
</VBox>
