<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="fr.utbm.petitschevaux.TirageController"
      alignment="CENTER" spacing="24.0" style="-fx-background-color: #f4f0e7;">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0"/>
    </padding>

    <Label text="Qui commence ?">
        <font>
            <Font name="System Bold" size="32.0"/>
        </font>
    </Label>
    <Label text="Chacun lance le dé : le plus haut score commence. En cas d'égalité, les ex æquo relancent."
           wrapText="true" style="-fx-text-fill: #6b665e;"/>

    <FlowPane fx:id="cartes" alignment="CENTER" hgap="16.0" vgap="16.0"/>

    <Label fx:id="message" wrapText="true" style="-fx-font-size: 16px;"/>

    <FlowPane alignment="CENTER" hgap="16.0" vgap="10.0">
        <Button text="Menu principal" onAction="#onRetourMenu" prefWidth="160.0"/>
        <Button fx:id="boutonCommencer" text="Commencer la partie" onAction="#onCommencer"
                prefWidth="200.0" defaultButton="true"/>
    </FlowPane>
</VBox>
