<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="fr.utbm.petitschevaux.PartieController">

    <center>
        <Pane fx:id="zonePlateau" prefWidth="600.0" prefHeight="600.0"/>
    </center>

    <right>
        <VBox alignment="CENTER" spacing="20.0" prefWidth="220.0">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
            </padding>
            <Label fx:id="resultatDe" text="Résultat du dé : " wrapText="true"/>
            <Label fx:id="information" text="Joueur 1 - lancez le dé" wrapText="true"/>
            <Button text="Lancer le dé" onAction="#onLancerDe"/>
            <Button text="Choisir le cheval" onAction="#onChoisirCheval"/>
        </VBox>
    </right>
</BorderPane>