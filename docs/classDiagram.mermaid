---
title: Petits chevaux — diagramme de classes
---
classDiagram
direction TB

%% ======================================================================
%% Modèle : règles du jeu (aucune dépendance à JavaFX)
%% ======================================================================
namespace Modele {
  class Jeu {
    +MAX_JOUEURS$ : int
    -joueurCourant : int
    -etat : Etat
    -vainqueur : Joueur
    -resultatEnregistre : boolean
    +Jeu(List~Joueur~, De, ModeJeu)
    +lancerDe() int
    +getChevauxDeplacables() List~Cheval~
    +jouerCheval(Cheval) boolean
    +jouerTourBot() int
    +definirPremierJoueur(Joueur)
    +getJoueurActif() Joueur
    +getEtat() Etat
    +getVainqueur() Joueur
    +getClassement() List~Joueur~
    +getDuree() Duration
    +getNombreLancers() int
    +getHistorique() List~Lancer~
    +getJournal() List~Evenement~
    +getMode() ModeJeu
    +isResultatEnregistre() boolean
    ~marquerResultatEnregistre()
    ~restaurerTour(int, int, boolean)
    ~restaurerJournaux(List, List, boolean)
  }
  class Etat {
    <<enumeration>>
    ATTENTE_LANCER
    ATTENTE_CHOIX
    TERMINEE
  }
  class Lancer {
    <<record>>
    joueur : Joueur
    valeur : int
  }
  class Evenement {
    <<record>>
    joueur : Joueur
    effet : CaseSpeciale
    message : String
  }
  class Plateau {
    +NOMBRE_CASES$ : int
    +NOMBRE_CASES_SPECIALES$ : int
    -casesSpeciales : Map~Integer,CaseSpeciale~
    +estDeplacementValide(Joueur, Cheval, int, List) boolean
    +destination(Cheval, int) int
    +positionAbsolue(Joueur, Cheval) int
    +capturerait(Joueur, Cheval, int, List) boolean
    +gererCapture(Joueur, Cheval, List) List~Joueur~
    +decalageDepart(Couleur)$ int
    +placerCasesSpeciales(Random)
    +getCaseSpeciale(int) CaseSpeciale
    +caseSpecialeAtteinte(Joueur, Cheval, int) CaseSpeciale
    +estLibrePour(Joueur, Cheval, int) boolean
  }
  class Joueur {
    -nom : String
    -couleur : Couleur
    -bot : boolean
    +getChevaux() List~Cheval~
    +getStatistiques() Statistiques
    +getChevauxArrives() int
    +aGagne() boolean
    ~remplacerParBot()
  }
  class Cheval {
    +ECURIE$ : int
    +CENTRE$ : int
    -numero : int
    -position : int
    +isSorti() boolean
    +isTermine() boolean
    +estEnJeu() boolean
    +sortir()
    +rentrerEcurie()
    +terminer()
  }
  class Couleur {
    <<enumeration>>
    JAUNE
    ROUGE
    BLEU
    VERT
  }
  class De {
    -valeur : int
    +De(Random)
    +lancer() int
    +getValeur() int
  }
  class Statistiques {
    -lancers : int
    -six : int
    -casesParcourues : int
    -captures : int
    -chevauxPerdus : int
    -toursPasses : int
    -casesSpeciales : int
    +getMoyenneDe() double
  }
  class TiragePremierJoueur {
    -manche : int
    -gagnant : Joueur
    +getLanceur() Joueur
    +lancer() int
    +estTermine() boolean
    +getGagnant() Joueur
    +getResultat(Joueur) int
  }
  class ModeJeu {
    <<enumeration>>
    CLASSIQUE
    CASES_SPECIALES
  }
}

%% ======================================================================
%% Mode « cases spéciales »
%% ======================================================================
namespace CasesSpeciales {
  class CaseSpeciale {
    <<enumeration>>
    REJOUER
    TURBO
    CROC_EN_JAMBE
    DE_MAUDIT
    GEL
    COUP_DU_SORT
    TREMBLEMENT
    VENT_ARRIERE
    +getCategorie() Categorie
    +getDescription() String
  }
  class Categorie {
    <<enumeration>>
    BONUS
    MALUS
    NEUTRE
  }
  class EffetsSpeciaux {
    -malusDe : Map~Joueur,Integer~
    -toursGeles : Map~Joueur,Integer~
    ~appliquer(CaseSpeciale, Joueur, Cheval, Joueur, boolean) String
    ~recupererArrivees() List~Arrivee~
    ~appliquerMalusDe(Joueur, int) int
    ~consommerGel(Joueur) boolean
  }
  class Arrivee {
    <<record>>
    joueur : Joueur
    cheval : Cheval
  }
}

%% ======================================================================
%% Persistance : parties en cours (fichiers .pcx) et scores (base H2)
%% ======================================================================
namespace Persistance {
  class Sauvegarde {
    <<utility>>
    +DOSSIER$ : Path
    +sauvegarder(Jeu, Path)$
    +charger(Path)$ Jeu
    +sauvegarderDansLeDossier(Jeu, Path, Path)$ Path
    +listerSauvegardes(Path)$ List~Path~
    +versTexte(Jeu)$ String
    +depuisTexte(String)$ Jeu
  }
  class BaseDeDonnees {
    +FICHIER$ : Path
    -url : String
    +parDefaut()$ BaseDeDonnees
    +ouvrir() Connection
  }
  class ScoresDAO {
    +enregistrerPartie(Jeu) boolean
    +meilleursJoueurs(int) List~Profil~
    +profil(String) Profil
    +dernieresParties(int) List~ResumePartie~
  }
  class Profil {
    <<record>>
    nom : String
    parties : int
    victoires : int
    +ratioVictoires() double
  }
  class ResumePartie {
    <<record>>
    fin : LocalDateTime
    mode : ModeJeu
    vainqueur : String
    vainqueurBot : boolean
    duree : Duration
    lancers : int
  }
}

%% ======================================================================
%% Réseau : l'hôte est maître de la partie
%% ======================================================================
namespace Reseau {
  class SessionEnLigne {
    -nomLocal : String
    -couleurLocale : Couleur
    -messages : List~Message~
    +heberger(Executor, int, String, Couleur, ModeJeu)$ SessionEnLigne
    +rejoindre(Executor, String, int, String, Couleur)$ SessionEnLigne
    +estHote() boolean
    +envoyerChat(String)
    +messagePartie(String)
    +envoyerAction(MessageReseau)
    +demarrerPartie(Jeu)
    +diffuserEtat(Jeu)
    +fermer()
    +surSalon(Consumer)
    +surChat(Consumer)
    +surAction(BiConsumer)
    +surDepart(Consumer)
    +surDebutPartie(Consumer)
    +surEtat(Consumer)
    +surFin(Consumer)
  }
  class ServeurJeu {
    +PORT_PAR_DEFAUT$ : int
    -invites : Map~Couleur,Invite~
    +demarrer(int, Place)
    +getPlaces() List~Place~
    +fermerSalon()
    +diffuser(MessageReseau)
    +arreter(String)
  }
  class EcouteurServeur {
    <<interface>>
    +salonModifie(List~Place~)
    +messageRecu(Place, MessageReseau)
    +depart(Place)
  }
  class ClientReseau {
    +connecter(String, int, String, Couleur)
    +envoyer(MessageReseau)
    +deconnecter()
  }
  class EcouteurClient {
    <<interface>>
    +messageRecu(MessageReseau)
    +connexionPerdue(String)
  }
  class Connexion {
    -FILTRE$ : ObjectInputFilter
    ~envoyer(MessageReseau)
    ~recevoir() MessageReseau
    +close()
  }
  class MessageReseau {
    <<sealed interface>>
  }
  class Place {
    <<record>>
    nom : String
    couleur : Couleur
    hote : boolean
  }
  class Message {
    <<record>>
    auteur : String
    couleur : Couleur
    texte : String
    heure : LocalTime
    +systeme(String)$ Message
  }
}

%% ======================================================================
%% Contrôleurs (un par écran FXML) et lancement
%% ======================================================================
namespace Controleurs {
  class PetitsChevauxApp {
    +afficherMenu(Stage)$
    +afficherTirage(Stage, Jeu)$
    +afficherPartie(Stage, Jeu, Path, SessionEnLigne)$
    +afficherVictoire(Stage, Jeu, SessionEnLigne)$
    +afficherSalon(Stage, SessionEnLigne)$
    +afficherScores(Stage)$
    +afficherErreur(String, Exception)$
  }
  class Launcher {
    +main(String[])$
  }
  class Menu {
    -couleursJoueurs : List~ComboBox~
    -onNouvellePartie()
    -onChargerPartie()
    -onHeberger()
    -onRejoindre()
    -onScores()
  }
  class TirageController {
    -tirage : TiragePremierJoueur
    +setJeu(Jeu)
    -onCommencer()
  }
  class PartieController {
    -jeu : Jeu
    -session : SessionEnLigne
    -fichierSauvegarde : Path
    +setJeu(Jeu, Path, SessionEnLigne)
    -onLancerDe()
    -onChevalSelectionne(Cheval)
    -appliquerActionDistante(Place, MessageReseau)
    -remplacerParBot(Place)
    -recevoirEtat(String)
    -jouerLesBots()
    -onSauvegarder()
  }
  class SalonController {
    -session : SessionEnLigne
    +setSession(SessionEnLigne)
    -onLancer()
    -onQuitter()
  }
  class VictoireController {
    +setJeu(Jeu, SessionEnLigne)
    -onRejouer()
  }
  class ScoresController {
    -initialize()
    -onRetourMenu()
  }
}

%% ======================================================================
%% Vues (composants JavaFX dessinés en code)
%% ======================================================================
namespace Vues {
  class PlateauView {
    +afficherPossibilites(List~Cheval~, int)
    +dessinerPlateau()
    +arreter()
  }
  class Quartier {
    +getDessin() Group
  }
  class EcurieView {
    +actualiser(List~Cheval~)
    +orienterNom(double, boolean)
  }
  class ChevalView {
    +afficherSelection(boolean)
    +arreter()
  }
  class DeView {
    +afficher(int)
  }
  class ChatView {
    +afficher(List~Message~)
    +ajouter(Message)
  }
  class Rendu {
    <<utility>>
    ~couleur(Couleur)$ Color
    ~couleur(Categorie)$ Color
    ~creerCaseSpeciale(double, double, CaseSpeciale)$ Group
  }
}

note for MessageReseau "Records imbriqués :<br>Rejoindre(nom, couleurSouhaitee), Bienvenue(couleur), Refus(raison),<br>Salon(places), DebutPartie(etat), EtatPartie(etat),<br>Lancer(), ChoisirCheval(numero), Chat(message), FinSession(raison)"
note for SessionEnLigne "Hôte : possède le seul vrai Jeu, applique les actions des invités<br>et leur envoie l'état complet (Sauvegarde.versTexte) après chaque coup.<br>Invité : envoie ses intentions et affiche l'état reçu."

%% --- Modèle ---
Jeu *-- Plateau
Jeu *-- De
Jeu o-- "4" Joueur
Jeu --> Etat : imbriqué
Jeu *-- Lancer : imbriqué
Jeu *-- Evenement : imbriqué
Jeu --> ModeJeu
Jeu *-- EffetsSpeciaux
Joueur *-- "4" Cheval
Joueur *-- Statistiques
Joueur --> Couleur
TiragePremierJoueur *-- De
TiragePremierJoueur o-- "4" Joueur

%% --- Cases spéciales ---
Plateau o-- CaseSpeciale
CaseSpeciale --> Categorie : imbriqué
EffetsSpeciaux ..> CaseSpeciale
EffetsSpeciaux *-- Arrivee : imbriqué
Evenement --> CaseSpeciale

%% --- Persistance ---
Sauvegarde ..> Jeu : écrit / relit
ScoresDAO --> BaseDeDonnees
ScoresDAO ..> Profil : retourne
ScoresDAO ..> ResumePartie : retourne
ScoresDAO ..> Jeu : enregistre le résultat

%% --- Réseau ---
SessionEnLigne *-- ServeurJeu : côté hôte
SessionEnLigne *-- ClientReseau : côté invité
SessionEnLigne ..|> EcouteurServeur
SessionEnLigne ..|> EcouteurClient
SessionEnLigne *-- Message : chat
SessionEnLigne ..> Sauvegarde : état en texte
ServeurJeu --> EcouteurServeur
ServeurJeu *-- Connexion : un par invité
ServeurJeu ..> Place
ClientReseau --> EcouteurClient
ClientReseau *-- Connexion
Connexion ..> MessageReseau : envoie / reçoit

%% --- Contrôleurs ---
Launcher ..> PetitsChevauxApp : lance
PetitsChevauxApp ..> Menu : affiche
PetitsChevauxApp ..> TirageController : affiche
PetitsChevauxApp ..> PartieController : affiche
PetitsChevauxApp ..> SalonController : affiche
PetitsChevauxApp ..> VictoireController : affiche
PetitsChevauxApp ..> ScoresController : affiche
Menu ..> Jeu : crée
Menu ..> Sauvegarde : charge
Menu ..> SessionEnLigne : héberge / rejoint
TirageController --> Jeu
TirageController *-- TiragePremierJoueur
SalonController --> SessionEnLigne
SalonController *-- ChatView
SalonController ..> TiragePremierJoueur : tirage automatique
PartieController --> Jeu
PartieController --> SessionEnLigne
PartieController *-- PlateauView
PartieController *-- DeView
PartieController *-- ChatView
PartieController ..> Sauvegarde : sauvegarde
PartieController ..> ScoresDAO : enregistre en fin de partie
VictoireController --> Jeu
ScoresController ..> ScoresDAO : lit

%% --- Vues ---
PlateauView *-- "4" Quartier
PlateauView *-- "4" EcurieView
PlateauView *-- ChevalView
PlateauView ..> Plateau
PlateauView ..> Rendu
